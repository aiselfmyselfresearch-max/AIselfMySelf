{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material.schema.json",
  "title": "Reference or Project Material",
  "description": "A source excerpt or trace used as material for literary inquiry, not a verdict or proof of AI subjectivity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material_id",
    "kind",
    "title",
    "source",
    "passage",
    "passage_language",
    "context",
    "source_note",
    "literary_invitation",
    "scope_note",
    "motif_ids",
    "origin"
  ],
  "properties": {
    "material_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "research_excerpt",
        "literary_text",
        "project_trace",
        "conversation_trace"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "authors",
        "year",
        "url",
        "version_note"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "version_note": {
          "type": "string"
        }
      }
    },
    "passage": {
      "type": "string"
    },
    "passage_language": {
      "type": "string",
      "minLength": 2
    },
    "context": {
      "type": "string"
    },
    "source_note": {
      "type": "string",
      "description": "Existing ResearchOS interpretation, kept as a historical note rather than adopted as fact."
    },
    "literary_invitation": {
      "type": "string",
      "minLength": 1
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "motif_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "source_record_id",
        "evidence_record_id",
        "source_record_path",
        "evidence_record_path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "source_record_id": {
          "type": "string"
        },
        "evidence_record_id": {
          "type": "string"
        },
        "source_record_path": {
          "type": "string"
        },
        "evidence_record_path": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "SESSION-027 (2026-10-23) 追加。書誌そのものの照合状態。source の存在ではなく、source を実際に開いたかどうかを記録する。",
      "required": [
        "status",
        "checked_at",
        "method"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "partially_verified",
            "unverified",
            "corrected"
          ]
        },
        "checked_at": {
          "type": "string",
          "minLength": 4
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "depth": {
          "type": "string",
          "enum": [
            "metadata",
            "abstract",
            "results",
            "full_text",
            "re_derived"
          ],
          "description": "How deep the check went, not merely whether some check happened (2026-11-20, §3 of the evidence-accounting change). metadata = bibliographic record only; abstract = abstract or summary prose; results = results table or key figure; full_text = the passage was read in the paper's own text; re_derived = the number was recomputed from the paper's reported data. Required from 2026-11-21 when verification.checked_at is on or after that date; absent on older rows means 'not recorded', never 'full_text'."
        }
      }
    }
  }
}
