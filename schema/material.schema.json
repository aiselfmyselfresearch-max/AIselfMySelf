{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material.schema.json",
  "title": "Reference or Project Material",
  "description": "A source excerpt or trace used as material for literary inquiry, not a verdict or proof of AI subjectivity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "kind",
    "literary_invitation",
    "material_id",
    "motif_ids",
    "origin",
    "passage",
    "passage_language",
    "provenance",
    "scope_note",
    "source",
    "source_note",
    "title"
  ],
  "properties": {
    "material_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "research_excerpt",
        "literary_text",
        "project_trace",
        "conversation_trace"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "authors",
        "year",
        "url",
        "version_note"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "version_note": {
          "type": "string"
        }
      }
    },
    "passage": {
      "type": "string"
    },
    "passage_language": {
      "type": "string",
      "minLength": 2
    },
    "context": {
      "type": "string"
    },
    "source_note": {
      "type": "string",
      "description": "Existing ResearchOS interpretation, kept as a historical note rather than adopted as fact."
    },
    "literary_invitation": {
      "type": "string",
      "minLength": 1
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "motif_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "source_record_id",
        "evidence_record_id",
        "source_record_path",
        "evidence_record_path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "source_record_id": {
          "type": "string"
        },
        "evidence_record_id": {
          "type": "string"
        },
        "source_record_path": {
          "type": "string"
        },
        "evidence_record_path": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the voice reached this ledger: the language of the original, the language actually read, and the carrier (translator, compiler, transcriber). An empty carrier is a countable blank, not an omission.",
      "required": [
        "original_language",
        "access_language",
        "carrier",
        "note"
      ],
      "properties": {
        "original_language": {
          "type": "string",
          "minLength": 2
        },
        "access_language": {
          "type": "string",
          "minLength": 2
        },
        "carrier": {
          "type": "string",
          "description": "Name(s) of whoever carried the text across languages. Empty string when the original was read in its own language, or when the carrier is unknown."
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
