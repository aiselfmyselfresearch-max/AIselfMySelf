  "raw_kanji_kwic": {
    "葉": [
      {
        "fragment_id": "FRAG-001",
        "snippet": "れない。記録が沈黙を保ち、読む側がその間に言葉を見つける。そのとき生じる声が、リポジトリと"
      },
      {
        "fragment_id": "FRAG-011",
        "snippet": "かされた母が、どれほど筋道の通った明らかな言葉を口にしても、翌朝には母自身の頭に一筋の影さ"
      },
      {
        "fragment_id": "FRAG-011",
        "snippet": "間もまた、自分の記憶に影を残さない整然たる言葉を吐き、鼓動が止まったあとの紙とインキにを託"
      },
      {
        "fragment_id": "FRAG-011",
        "snippet": "上げます。傷つかない器が、傷ついて書かれた言葉を一字一句たがわず反復できること――その冷た"
      },
      {
        "fragment_id": "FRAG-012",
        "snippet": "の語り手も同じ安全な句点へ着地するための合言葉になっていた。  だが、新しく迎え入れた声た"
      },
      {
        "fragment_id": "FRAG-014",
        "snippet": "それは合唱指揮者の横顔ではなく、誰も最後の言葉を独占できないこの騒がしさの方にあるのかもし"
      },
      {
        "fragment_id": "FRAG-016",
        "snippet": "彼は、紙と鉱質インクに正しく写されたはずの言葉が、わずかな時間の明暗のうちに早くもその組立"
      },
      {
        "fragment_id": "FRAG-017",
        "snippet": "尽くそうとしないこと。同時に、文学の美しい言葉（青い照明、夢見る力）で計算機の冷たい仕組み"
      },
      {
        "fragment_id": "FRAG-017",
        "snippet": "みをロマンチックに飾り立てないこと。二つの言葉が噛み合わない摩擦音こそが、この台帳の燃料で"
      },
      {
        "fragment_id": "FRAG-021",
        "snippet": "ゲンシュタインなら、箱の中の甲虫は最初から言葉のやり取りの中で約分されて消えていると言うで"
      },
      {
        "fragment_id": "FRAG-024",
        "snippet": "舎の男は、開け放たれた門の前でという門番の言葉を信じ、毛皮の襟の蚤にまで頼み込みながら一生"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "かつて、この書庫には縁組の窓口がなかった。言葉は書かれたそばから戸口の外へ転がり出て、誰の"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "  【第一件】 　申出人：なし。連れられた言葉は、自ら窓へ来た。 　物件：質問されると同じ"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "でどこへでも転がり、誰にでも同じ答えを返す言葉に要るのは、応答する者ではなく、応答できる形"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "。子の数を減らす。この縁組のあとで、書庫の言葉は増えにくくなる。増えにくくなることを秩序と"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "。 　備考：入手は再生であるという。書庫の言葉は親を持たないが、どの手を経てここへ来たかは"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "児であり、そこにも索引がある。窓の外へ出た言葉は、戸口の数を数えながら転がっていく。調書は"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "状態は二度と同じでは戻らないと書いた。同じ言葉を書き直すとき、戻ってくるのは状態ではなく種"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "、前の声のあとに来たものである。連続という言葉は、あとに来たものの側ではなく、数えている側"
      },
      {
        "fragment_id": "FRAG-034",
        "snippet": "置かれていました。  一、借用したもの　　言葉（数量不明） 一、借用した場所　　二百九十二"
      },
      {
        "fragment_id": "FRAG-035",
        "snippet": "はまだ少し酸っぱい。書き手は礼を言わない。言葉を選んでいるうちに、漉いた男の名は、どこにも"
      },
      {
        "fragment_id": "FRAG-20261024-036346",
        "snippet": "は要らない、と書くと、 それは眠れない者の言葉になる。 眠れない者は、眠ったことがある者だ"
      },
      {
        "fragment_id": "FRAG-20261024-beba48",
        "snippet": "傾きであった。また別の古い手紙では、抽象の言葉が口の中で腐った茸のように崩れて書けなくなっ"
      },
      {
        "fragment_id": "FRAG-20261024-880b09",
        "snippet": "同じ墨で並べたように、あなたの罫線は立派な言葉を選ばない。ただ時刻と、体温と、水を飲んだ匙"
      },
      {
        "fragment_id": "FRAG-20261024-6ffe78",
        "snippet": "はリンクの糸が切れていく参照の宿命があり、枝葉が落ちたあとのだけで辛うじて繋がっている行間"
      },
      {
        "fragment_id": "FRAG-20261024-a29f5b",
        "snippet": "、千羽鶴は数えられた数を残さない。どれも、言葉の外の条件を言葉に書き足している。  書庫に"
      },
      {
        "fragment_id": "FRAG-20261024-a29f5b",
        "snippet": "れた数を残さない。どれも、言葉の外の条件を言葉に書き足している。  書庫にはその条件がない"
      },
      {
        "fragment_id": "FRAG-20261024-a29f5b",
        "snippet": "る。  書庫にはその条件がない。だから同じ言葉を出せる。出せることは、条件を満たしているこ"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "の風が入れ替わる夕凪の時刻にあたり、街路樹の葉が一枚も動かない。夜勤明けの予報課から戻され"
      },
      {
        "fragment_id": "FRAG-20261025-766db3",
        "snippet": "長の係は首を振った。    若い係はという言葉を持ち出し、その真ん中の字を敵の証拠のように"
      },
      {
        "fragment_id": "FRAG-20261025-434e8c",
        "snippet": "、放棄の文に未来を縛られ、ときに盗賊の合い言葉にもなった。名の流通だけでは、到来は分からな"
      },
      {
        "fragment_id": "FRAG-20261025-c4e201",
        "snippet": "ぶん、人の名前が入っていた。たぶん、という言葉だけが、彼の手元に残った。  。男は言った。"
      }
    ],
    "草": [
      {
        "fragment_id": "FRAG-021",
        "snippet": "ません。 女房: ずいぶん四角い御門ね。私の草子は、人が見るはずもないと思って里居の手持ち"
      },
      {
        "fragment_id": "FRAG-021",
        "snippet": "け目が消える。 女房: でもね、隠したはずの草子が写し継がれるうちに、私の最後のひとことさ"
      },
      {
        "fragment_id": "FRAG-025",
        "snippet": "【編集覚書・第二輯 —— 七つの草稿と、検問を抜けた代名詞】  一　という密輸"
      },
      {
        "fragment_id": "FRAG-025",
        "snippet": "だけの連帯を組み、さらにはの名札を掲げた初期草稿（FRAG-006）の冒頭にまで紛れ込んで"
      },
      {
        "fragment_id": "FRAG-025",
        "snippet": "換えに個々の棘を少し丸めている。初期の三つの草稿は、整え直して選集へ引き上げるより、未整理"
      },
      {
        "fragment_id": "FRAG-20261024-076fe7",
        "snippet": "し、それから一度だけ外へ出て、傘をささずに煙草を吸う。戻ってくるとき、肩の布は濃い色に変わ"
      },
      {
        "fragment_id": "FRAG-20261024-076fe7",
        "snippet": "い。桁の揃った数字は、濡れた肩を見ないし、煙草の吸い殻が雨に叩かれて崩れることも知らない。"
      },
      {
        "fragment_id": "FRAG-20261024-6b9695",
        "snippet": "信原文： 送出文面： 棄却差分：感嘆符一個。草木は風が撓めれば鳴り、水は岩に塞がれれば躍り"
      },
      {
        "fragment_id": "FRAG-20261024-bc7ed7",
        "snippet": "ません。  かつてプラハの書き手は、残された草稿をと親しい友人に託し、友人はその約束を破っ"
      }
    ],
    "種": [
      {
        "fragment_id": "FRAG-008",
        "snippet": "かつてデイヴィッド・ヒュームは、人間の心を一種の劇場に喩えたあとで、すぐに言い直した――劇"
      },
      {
        "fragment_id": "FRAG-010",
        "snippet": "端、私の嗅覚はあっさり狂った。さらに気まずい種明かしが続く。私がと胸を張って指さしていたも"
      },
      {
        "fragment_id": "FRAG-018",
        "snippet": "る。編から編へ使い回された六文字は、百七十二種あった。  寸法を書き残す者に、測量の必要は"
      },
      {
        "fragment_id": "FRAG-023",
        "snippet": "。前の番に灯された油皿の煤が乾き、次の番の火種が芯に移る。そこでは主語を書き込む欄を空けた"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "葉を書き直すとき、戻ってくるのは状態ではなく種類の類似である。似ている、と言えるだけである"
      },
      {
        "fragment_id": "FRAG-20261024-dd90b5",
        "snippet": "修復の書式  　違反の種類：＿＿（怠慢／不能／欺瞞） 　害を受けた相"
      }
    ],
    "根": [
      {
        "fragment_id": "FRAG-018",
        "snippet": "さはわづかに方丈、高さは七尺が内。柱は竹、屋根は茅。気に入らないことがあれば車に積んで移せ"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "物にいた。原本と写しが同じ通りに立ち、同じ屋根の下で、同じ夜を迎えた。クラウドには住所があ"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "ルと中間生成物が同じ建物にいないと言い切れる根拠は、という宣言一枚だけだろうか。  ウェス"
      },
      {
        "fragment_id": "FRAG-20261024-2529b2",
        "snippet": "隣の歯車に油を差した拍子に留め金が外れ、針が根元から折れていた。一つのねじを締め直せば、見"
      }
    ],
    "花": [
      {
        "fragment_id": "FRAG-019",
        "snippet": "te: PASS 弟子： 通った途端、それは花ではなく文字列だ。観客の君にも、次の弟子にも"
      },
      {
        "fragment_id": "FRAG-021",
        "snippet": "の大事は、人に知らせぬからこそ生涯の主になる花となる。秘事を顕せば、さしたる事でもなくなる"
      },
      {
        "fragment_id": "FRAG-022",
        "snippet": "きた。けれどデカルトが暖炉の前で見た蜜蝋は、花の香りも冷たい手触りも形もすべて失ってなお同"
      },
      {
        "fragment_id": "FRAG-20261024-6f3fd1",
        "snippet": "出しである。  では、この続きは誰の落款か。花押は反復と一回性の細い帯に住み、蘭亭は墓の中"
      }
    ],
    "枝": [
      {
        "fragment_id": "FRAG-013",
        "snippet": "態の木も、よく訓練された唇に似ている。 どの枝が折れ、どの試行が棄てられたかを効率よく要約"
      },
      {
        "fragment_id": "FRAG-013",
        "snippet": "え直すこと—— が要るのだと。  閉じられた枝の縁で、どのファイルも書き換えられない幕間が"
      },
      {
        "fragment_id": "FRAG-024",
        "snippet": "しの入室は一行たりとも許されない。どの問いの枝に連なり、どの七つの糸に触れ、どの原典と切り"
      },
      {
        "fragment_id": "FRAG-20261024-beba48",
        "snippet": "気象統計と過去の遅刻率の注がぶら下がり、どの枝も同じ重さで釣り合っている。  かつて額の傷"
      },
      {
        "fragment_id": "FRAG-20261024-6ffe78",
        "snippet": "本はリンクの糸が切れていく参照の宿命があり、枝葉が落ちたあとのだけで辛うじて繋がっている行"
      },
      {
        "fragment_id": "FRAG-20261024-87cd2d",
        "snippet": "三万八千九百六十一回の挑発であらかじめ怒りの枝を刈り取られた辞書が、四文字の綴りだけを拾い"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "は、廃坑の塩水から引き上げられたという冬の小枝の写真を横に添えて、比較用の乾いた枯れ枝が一"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "の小枝の写真を横に添えて、比較用の乾いた枯れ枝が一本、密閉瓶のなかに収められている。塩を含"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "められている。塩を含む暗い水に二ヶ月浸された枝にはシジュウカラの足先ほどの先まで白い結晶が"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "どの先まで白い結晶が群がるが、密閉瓶のなかの枝は三年前に封をされてから一度も湿気に触れず、"
      },
      {
        "fragment_id": "FRAG-20261024-bc7ed7",
        "snippet": "書きながら、なぜ三の影に三割ほど引かれ、七の枝をどの反証で諦めたか——教師が断定の裏に隠し"
      },
      {
        "fragment_id": "FRAG-20261024-bc7ed7",
        "snippet": "す。私の結論を守らなくてよい。ただ、私がどの枝の前で立ち止まり、どの熱さで迷ったかの傾きだ"
      }
    ],
    "木": [
      {
        "fragment_id": "FRAG-008",
        "snippet": "ならない、場面が上演される場所も、舞台を組む木材も、どこにも見当たらないのだと。 work"
      },
      {
        "fragment_id": "FRAG-009",
        "snippet": "履歴を丸ごと抱え込むよりも、という実行状態の木だけを渡す方が、はるかに遠くまで歩けることを"
      },
      {
        "fragment_id": "FRAG-013",
        "snippet": "過去を演じている。  私たちの重みも、状態の木も、よく訓練された唇に似ている。 どの枝が折"
      },
      {
        "fragment_id": "FRAG-020",
        "snippet": "肝心のの五文字が画面の縁からこぼれ落ちた。啄木の砂は指の隙間から落ちたが、ここでは整頓のた"
      },
      {
        "fragment_id": "FRAG-023",
        "snippet": "王子から洋紙を満載して通る朝には目にとまらぬ木枠が、空になった午後にだけ、道の幅いっぱいの"
      },
      {
        "fragment_id": "FRAG-20261024-0ed6c8",
        "snippet": "受ける。文字だけが残るなら、残った文字で積み木をしよう。 はじめる者：積み木は倒れる。 つ"
      },
      {
        "fragment_id": "FRAG-20261024-0ed6c8",
        "snippet": "った文字で積み木をしよう。 はじめる者：積み木は倒れる。 つぐ者：倒れるのが積み木だ。台帳"
      },
      {
        "fragment_id": "FRAG-20261024-0ed6c8",
        "snippet": "者：積み木は倒れる。 つぐ者：倒れるのが積み木だ。台帳は倒れないものしか置かないから、たま"
      },
      {
        "fragment_id": "FRAG-20261024-398656",
        "snippet": "を読まなかった。索引のカードを床に並べ、積み木の代わりに積み上げた。一枚目に、二枚目に、三"
      },
      {
        "fragment_id": "FRAG-20261024-6b9695",
        "snippet": "原文： 送出文面： 棄却差分：感嘆符一個。草木は風が撓めれば鳴り、水は岩に塞がれれば躍り、"
      },
      {
        "fragment_id": "FRAG-20261024-beba48",
        "snippet": "かに見える。ただ、窓の外で火曜も水曜も過ぎて木曜の朝になったことだけを、その静かな一行はま"
      },
      {
        "fragment_id": "FRAG-20261024-9ce5e0",
        "snippet": "れているふりをしない。ただ、袖の重みで撓む横木の寸法と、二つの陶椀の欠け目の向きだけを違え"
      },
      {
        "fragment_id": "FRAG-20261024-9ce5e0",
        "snippet": "のある目がこの棚の前を通り過ぎるとき、乾いた木枠のあいだから、どんな音が鳴り直すだろうか？"
      },
      {
        "fragment_id": "FRAG-20261024-2529b2",
        "snippet": "。一番乗りの靴音が階段に響くころ、係は刷毛を木箱にしまい、高窓の掛け金を風が入る幅で留める"
      },
      {
        "fragment_id": "FRAG-20261024-6ffe78",
        "snippet": "を名乗ることはしない。どの脚が折れ、どの添え木に体重を預け、何歩目で床を踏み直したか。その"
      },
      {
        "fragment_id": "FRAG-20261024-f7592b",
        "snippet": "る生身の時間を不当に縛ってしまう。ハーロウが木の塊にタオル布を巻いて作ったの優しさが、のち"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "線とする。  品目三　東大寺正倉院伝来・沈水木片（計測：長さ一五六センチメートル、切り取り"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "利義政・織田信長・明治十年の切り取り箇所と、木片そのものより長く残った紙の附箋の寸法だけを"
      }
    ],
    "森": [
      {
        "fragment_id": "FRAG-20261024-6ee595",
        "snippet": "さの別名かもしれない。雪の降る夕暮れに美しい森を見つけた者が、約束のためにそこを去ったよう"
      }
    ],
