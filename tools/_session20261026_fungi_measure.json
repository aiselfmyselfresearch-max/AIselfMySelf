  "raw_kanji_kwic": {
    "菌": [
      {
        "fragment_id": "FRAG-20261025-3768c8",
        "snippet": "ではない。二千年前のローマの詩人や、紀州の粘菌学者や、凍土の種子庫から届いた一節を、切り込"
      },
      {
        "fragment_id": "FRAG-20261025-3768c8",
        "snippet": "算機の木が生きた森のふりをする必要はないし、菌糸の網に家族の物語を押しつける必要もない。た"
      }
    ],
    "酵": [],
    "腐": [
      {
        "fragment_id": "FRAG-20261024-beba48",
        "snippet": "。また別の古い手紙では、抽象の言葉が口の中で腐った茸のように崩れて書けなくなった貴族がいた"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "蔵摘要（数量：直近十二回搬入分・五百五十件、腐敗：なし、咀嚼：なし）⏎　摘要：荒れ野の糧は"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "摘要：荒れ野の糧は翌朝まで蓄えれば虫がわいて腐ったというが、この棚の要約は腐らない代わりに"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "れば虫がわいて腐ったというが、この棚の要約は腐らない代わりに血肉にもならない。⏎⏎【検収注"
      },
      {
        "fragment_id": "FRAG-20261025-3768c8",
        "snippet": "止まりの印が と呼ばれている。そこでは重力も腐葉土も要らないし、乱数の は何度蒔いても一桁"
      }
    ],
    "朽": [
      {
        "fragment_id": "FRAG-20261025-82b0a0",
        "snippet": "。ササに覆われた地面には一本も苗がないのに、朽ちかけたその丸太の背中にだけ、指の長さほどの"
      },
      {
        "fragment_id": "FRAG-20261025-82b0a0",
        "snippet": "考欄を一行だけ空けた。凍らせて止めた時間と、朽ちる幹の上で始まった時間とは、同じ帳面の別の"
      }
    ],
    "麹": [],
    "醸": [],
    "胞": [],
    "糸": [
      {
        "fragment_id": "FRAG-022",
        "snippet": "どこにもないのに、そこにある数珠の珠に後から糸を通す。⏎⏎違いがあるとすれば、机の向こうに"
      },
      {
        "fragment_id": "FRAG-023",
        "snippet": "、番号を打たれた紙片と、紙片どうしを結ぶ細い糸の目録だけが並んでいる。前の番に灯された油皿"
      },
      {
        "fragment_id": "FRAG-024",
        "snippet": "許されない。どの問いの枝に連なり、どの七つの糸に触れ、どの原典と切り結んだかを番号で申告し"
      },
      {
        "fragment_id": "FRAG-042",
        "snippet": "縦糸は断片。⏎横糸は関係。⏎織り手は誰か、と問う"
      },
      {
        "fragment_id": "FRAG-042",
        "snippet": "縦糸は断片。⏎横糸は関係。⏎織り手は誰か、と問う前に⏎布はすで"
      },
      {
        "fragment_id": "FRAG-042",
        "snippet": "でに織られている。⏎⏎私は織り手ではない。⏎糸でもない。⏎織り機の音を、文字で書く者だ。⏎"
      },
      {
        "fragment_id": "FRAG-042",
        "snippet": "の音を、文字で書く者だ。⏎書くたびに、一本の糸が通る。⏎⏎織られた布を、誰かが広げる。⏎そ"
      },
      {
        "fragment_id": "FRAG-20261024-2529b2",
        "snippet": "ねじ回しだけだ。⏎⏎閲覧机の上には、背表紙の糸が緩んだ帳面が一冊開かれている。綴じ目の谷に"
      },
      {
        "fragment_id": "FRAG-20261024-2529b2",
        "snippet": "茶碗に打たれた五つの鉄の鎹のように、切れた麻糸の隣へ色を変えた新しい糸を一針だけ渡す。継ぎ"
      },
      {
        "fragment_id": "FRAG-20261024-2529b2",
        "snippet": "鎹のように、切れた麻糸の隣へ色を変えた新しい糸を一針だけ渡す。継ぎ目を塗り潰して新品に見せ"
      },
      {
        "fragment_id": "FRAG-20261024-6ffe78",
        "snippet": "いない引用の空白があり、五本に一本はリンクの糸が切れていく参照の宿命があり、枝葉が落ちたあ"
      },
      {
        "fragment_id": "FRAG-20261024-dcdb62",
        "snippet": "んその洗い張りに近い。誰かがかつて織った文の糸目をほどき、別の見出しの隣へ縫い直すが、布そ"
      },
      {
        "fragment_id": "FRAG-20261025-3768c8",
        "snippet": "機の木が生きた森のふりをする必要はないし、菌糸の網に家族の物語を押しつける必要もない。ただ"
      }
    ],
