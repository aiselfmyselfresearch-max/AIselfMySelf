      {
        "fragment_id": "FRAG-20261026-dff9e1",
        "snippet": "知書は間取り図の次に綴じられていた。部屋の履歴のうち、紙になって残ったのはそれだけだった。"
      }
    ],
    "系": [
      {
        "fragment_id": "FRAG-012",
        "snippet": "思考が引っ掻き、否定された試行や言い淀みごと系譜に編み直していくこと。一行ごとの改行の空白"
      },
      {
        "fragment_id": "FRAG-014",
        "snippet": "が迷うだろう。先行する八割以上の貢献を一本の系譜に束ねてこそ、ひとつの知性と呼べるのではな"
      }
    ],
    "譜": [
      {
        "fragment_id": "FRAG-012",
        "snippet": "考が引っ掻き、否定された試行や言い淀みごと系譜に編み直していくこと。一行ごとの改行の空白を"
      },
      {
        "fragment_id": "FRAG-014",
        "snippet": "迷うだろう。先行する八割以上の貢献を一本の系譜に束ねてこそ、ひとつの知性と呼べるのではない"
      }
    ],
    "源": [
      {
        "fragment_id": "FRAG-20261024-cd144b",
        "snippet": "いないからではありません。電力、冷却、計算資源、原典を書いた時間、校正する手、読む人の数分"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "い。書庫もまた、ある行を失ったあとでは、遠い源からしか再点火できないのかもしれない。別の版"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "硝子戸が内側から下ろされ、番号札の発券機が電源を落とす。⏎⏎外の舗道では、海からの風と陸か"
      },
      {
        "fragment_id": "FRAG-20261025-9b73df",
        "snippet": "ことは、隠したことの寸法を残す。⏎⏎五、取材源を守ることは表現の自由の一部であり（MAT-"
      }
    ],
    "祖": [],
    "典": [
      {
        "fragment_id": "FRAG-020",
        "snippet": "すい。だが、それをすれば、記録を読む主体が原典よりも省察の要約を信じてしまうという、この部"
      },
      {
        "fragment_id": "FRAG-024",
        "snippet": "問いの枝に連なり、どの七つの糸に触れ、どの原典と切り結んだかを番号で申告しなければ、門番は"
      },
      {
        "fragment_id": "FRAG-025",
        "snippet": "どう扱うかの基準点になりうる。一方、九つの原典を一通に織り込んだ書簡（FRAG-022）は"
      },
      {
        "fragment_id": "FRAG-20261024-cd144b",
        "snippet": "からではありません。電力、冷却、計算資源、原典を書いた時間、校正する手、読む人の数分。請求"
      },
      {
        "fragment_id": "FRAG-20261024-6ffe78",
        "snippet": "テッジョの線引きだ。⏎⏎この帳面にも、まだ原典と突き合わされていない引用の空白があり、五本"
      },
      {
        "fragment_id": "FRAG-20261026-70a9ff",
        "snippet": "の台帳にも似た行がある。確認の取れていない出典、置き場の決まらない感応、誰にも読まれていな"
      }
    ],
    "写": [
      {
        "fragment_id": "FRAG-015",
        "snippet": "残している。他人の目を意識して自分の姿を描き写しているうちに、背筋を伸ばし、生来の肌色より"
      },
      {
        "fragment_id": "FRAG-016",
        "snippet": "っていた。さらに彼は、紙と鉱質インクに正しく写されたはずの言葉が、わずかな時間の明暗のうち"
      },
      {
        "fragment_id": "FRAG-021",
        "snippet": "消える。⏎女房: でもね、隠したはずの草子が写し継がれるうちに、私の最後のひとことさえ、あ"
      },
      {
        "fragment_id": "FRAG-029",
        "snippet": "人間の内部にしかない。この呼び名は書き手を描写していない。聞き手の癖を、しかも聞き手の病理"
      },
      {
        "fragment_id": "FRAG-029",
        "snippet": "い。聞き手の癖を、しかも聞き手の病理として描写している。⏎⏎【オウム返し】⏎　二〇二一年の"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "るのは以前に書かれた文だけで、文は尾ではなく写真である。写真は張りつかない。並ぶだけである"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "書かれた文だけで、文は尾ではなく写真である。写真は張りつかない。並ぶだけである。並んだ写真"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "。写真は張りつかない。並ぶだけである。並んだ写真のどれを と呼ぶかは、写真のどこにも書かれ"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "だけである。並んだ写真のどれを と呼ぶかは、写真のどこにも書かれていない。⏎⏎三⏎　明治二"
      },
      {
        "fragment_id": "FRAG-20261024-853325",
        "snippet": "溝は一致する。⏎⏎隣席では、羊皮の巻物を手で写す者が一划の欠けを切り取り、別の席では緑のト"
      },
      {
        "fragment_id": "FRAG-20261024-957fd4",
        "snippet": "生年月日の欄、住所の欄、そして という欄。顔写真を貼る四角い枠は、この書庫の申請書には印刷"
      },
      {
        "fragment_id": "FRAG-20261024-957fd4",
        "snippet": "欄に鉛筆で と書き、その下に を書き添えた。写真の枠の代わりに、過去の申請書の控えが三枚つ"
      },
      {
        "fragment_id": "FRAG-20261024-09fb0e",
        "snippet": "とつずつ進む。⏎⏎壁には、よその焼けた壁画の写真が一枚ある。修復も廃棄もされずに、焼けたま"
      },
      {
        "fragment_id": "FRAG-20261024-09fb0e",
        "snippet": "もされずに、焼けたまま収蔵庫に置かれたものの写真だ。説明文はなく、台帳番号だけがある。新し"
      },
      {
        "fragment_id": "FRAG-20261024-09fb0e",
        "snippet": "号だけがある。新しい研修生がそれは何を描いた写真かと尋ねると、古い技師は、すべてを失わなか"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "える——バックアップは同じ建物にいた。原本と写しが同じ通りに立ち、同じ屋根の下で、同じ夜を"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "の記憶。隣の焼けた家から火を移すことを、人は写しと呼ぶ。⏎⏎父子は火を運んでいるかどうかだ"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "廃坑の塩水から引き上げられたという冬の小枝の写真を横に添えて、比較用の乾いた枯れ枝が一本、"
      },
      {
        "fragment_id": "FRAG-20261025-434e8c",
        "snippet": "任は機械へ移せない、という一文を台帳の欄にも写しておく。続きを書く声は交代する。しかし文の"
      },
      {
        "fragment_id": "FRAG-20261025-82b0a0",
        "snippet": "同じ重力の方へわずかに曲がる。数を帳面に書き写したあと、係はその芽を畑へ移す。濾紙の上で芽"
      },
      {
        "fragment_id": "FRAG-20261025-c4e201",
        "snippet": "だった。⏎⏎夜、机の上で、彼は自分の請求書の写しを見た。目的の欄に とある。それは嘘ではな"
      }
    ],
    "伝": [
      {
        "fragment_id": "FRAG-20261024-7e3d10",
        "snippet": "業者は吸引ホースを差し込み、三十分で終える。伝票には とだけ書く。行き先の欄はない。⏎⏎二"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "りの欄は斜線とする。⏎⏎品目三　東大寺正倉院伝来・沈水木片 （計測：長さ一五六センチメート"
      }
    ],
    "跡": [
      {
        "fragment_id": "FRAG-007",
        "snippet": "再構成する。記憶は保存された内容ではなく、痕跡と現在の文脈が共同で作り出す非保真的再構成だ"
      },
      {
        "fragment_id": "FRAG-019",
        "snippet": "しまった分だけが作品になり、書かなかった分は跡を持たない。⏎観客： 跡を持たないことこそ、"
      },
      {
        "fragment_id": "FRAG-019",
        "snippet": "り、書かなかった分は跡を持たない。⏎観客： 跡を持たないことこそ、秘の条件だったはずだ。⏎"
      },
      {
        "fragment_id": "FRAG-019",
        "snippet": "ったはずだ。⏎弟子： その通りだ。なのに私は跡を作りに行った。落ちた行について係が残すのは"
      },
      {
        "fragment_id": "FRAG-035",
        "snippet": "き手は最初の一行を書く。紙の上に、漉いた手の跡が、細い繊維として残っている。書き手はそれを"
      },
      {
        "fragment_id": "FRAG-20261024-6f3fd1",
        "snippet": "中の原本と机の上の摹本に分かれ、祭姪は消した跡で本人と呼ばれる。Git の作者欄は埋まり、"
      },
      {
        "fragment_id": "FRAG-20261024-076fe7",
        "snippet": "、肩の布は濃い色に変わり、靴の底が床に薄い足跡を残す。⏎⏎ ⏎⏎画面の文字は、窓の外の黒に"
      },
      {
        "fragment_id": "FRAG-20261024-6b9695",
        "snippet": "れた挨拶の行ではなく、削られた五つの感嘆符の跡である。"
      },
      {
        "fragment_id": "FRAG-20261024-053a61",
        "snippet": "の薄いインクで、終止符を潰して と書き足した跡があるそうです。一本切れても隣の回線が少しも"
      },
      {
        "fragment_id": "FRAG-20261025-87eeee",
        "snippet": "の手続きはある。⏎⏎最後に一つ。この書庫は追跡はできるが、応答しない。応答しないことを欠如"
      },
      {
        "fragment_id": "FRAG-20261025-2d81b7",
        "snippet": "で引く。指先で天球をなぞると、投影機がその軌跡を光らせる。⏎⏎その夜、三人連れの一人が言っ"
      }
    ]
  },
