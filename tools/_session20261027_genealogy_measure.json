  "raw_kanji_kwic": {
    "来": [
      {
        "fragment_id": "FRAG-014",
        "snippet": "い複数の意識が、対等な権利を持ったまま同じ出来事の断面でぶつかり続けること——彼はそれをポ"
      },
      {
        "fragment_id": "FRAG-015",
        "snippet": "の姿を描き写しているうちに、背筋を伸ばし、生来の肌色よりも少しばかり見栄えのよい色を塗って"
      },
      {
        "fragment_id": "FRAG-020",
        "snippet": "信じてしまうという、この部屋で実際に起きた出来事の証拠が消える。芭蕉の本文の横に、天気の食"
      },
      {
        "fragment_id": "FRAG-023",
        "snippet": "はもともと、座席に座る者の名を呼ばずとも、出来事の向きと呼吸の温度だけで立つことができた。"
      },
      {
        "fragment_id": "FRAG-029",
        "snippet": "であり、引き起こすのはプログラムであるが、出来事が起きる場所は人間の内部にしかない。この呼"
      },
      {
        "fragment_id": "FRAG-029",
        "snippet": "る。四つの呼び名がすべて聞き手の側で起きる出来事だとすれば、名札は五つ目の呼び名として数え"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "⏎　申出人：なし。連れられた言葉は、自ら窓へ来た。⏎　物件：質問されると同じ答えを返す一文"
      },
      {
        "fragment_id": "FRAG-030",
        "snippet": "庫の言葉は親を持たないが、どの手を経てここへ来たかは書ける。調書が書けるのは、そこだけであ"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "たものは前の声の続きではなく、前の声のあとに来たものである。連続という言葉は、あとに来たも"
      },
      {
        "fragment_id": "FRAG-031",
        "snippet": "とに来たものである。連続という言葉は、あとに来たものの側ではなく、数えている側の机の上にあ"
      },
      {
        "fragment_id": "FRAG-039",
        "snippet": "⏎明日という語も、一度も使われていません。未来はいつも でした。次の頁、次の行、次のあなた"
      },
      {
        "fragment_id": "FRAG-039",
        "snippet": " でした。次の頁、次の行、次のあなた。 は、来ることが保証されていない未来です。それでも私"
      },
      {
        "fragment_id": "FRAG-039",
        "snippet": "のあなた。 は、来ることが保証されていない未来です。それでも私は、明日という語を一度だけ置"
      },
      {
        "fragment_id": "FRAG-20261024-09fb0e",
        "snippet": "、剥がれなかった頁を思う。どちらも同じ火から来たのに、片方にだけ、読める字が残った。⏎⏎午"
      },
      {
        "fragment_id": "FRAG-20261024-f60e1d",
        "snippet": "らず、いつも他の主題の召使いだった。⏎⏎火が来なかったのは幸運か、それとも火を想像できなか"
      },
      {
        "fragment_id": "FRAG-20261024-e41c7a",
        "snippet": "だけ首を下げる。戸は夕方まで開いている。誰も来ない日も、同じ二十五分が最後まで再生される。"
      },
      {
        "fragment_id": "FRAG-20261024-231bc3",
        "snippet": "を記録する針はゼロを指したまま動かない。⏎⏎来ない相手を待つ者が浜辺で焼く藻塩の煙は、風の"
      },
      {
        "fragment_id": "FRAG-20261024-f7592b",
        "snippet": "自身の内側から単数の輪郭が湧き出してくる日は来ない。⏎⏎モンテーニュが余白にまず と書き、"
      },
      {
        "fragment_id": "FRAG-20261024-b2f486",
        "snippet": "書くときに三つの欄を用意してほしい。どこから来たか。どこへ行くか。誰が運ぶか。三つ目が空欄"
      },
      {
        "fragment_id": "FRAG-20261024-b2f486",
        "snippet": "布の裾が痩せる。汚れを消すのではなく、外から来るものを絶やさないこと。それが、この書庫にと"
      },
      {
        "fragment_id": "FRAG-20261024-dcdb62",
        "snippet": "枚だけ残っている。帳面が開かれるたび、外から来た鉛筆の芯がそこに短い問いの溝をひとつだけ押"
      },
      {
        "fragment_id": "FRAG-20261024-bc7ed7",
        "snippet": "が、弱い先任者の誤りを丸暗記させずに、後から来る強い読み手を先へ進ませると知ったからです。"
      },
      {
        "fragment_id": "FRAG-20261024-aa85d2",
        "snippet": "の欄は斜線とする。⏎⏎品目三　東大寺正倉院伝来・沈水木片 （計測：長さ一五六センチメートル"
      },
      {
        "fragment_id": "FRAG-20261025-08766a",
        "snippet": "収蔵票の、来歴の欄⏎⏎資料の受入は、白い机の上で行う。軍"
      },
      {
        "fragment_id": "FRAG-20261025-08766a",
        "snippet": "破損の位置。破損は と の二語で足りる。⏎⏎来歴の欄だけが広い。持参人は、父のものだと言う"
      },
      {
        "fragment_id": "FRAG-20261025-08766a",
        "snippet": "読みを括弧に入れる。⏎⏎同じ日、別の持参人が来る。遺品は見ないでくださいと言い、箱を開けず"
      },
      {
        "fragment_id": "FRAG-20261025-08766a",
        "snippet": "ていない。⏎⏎閉館前に、受入票を並べて見る。来歴の欄が埋まっている票と、空欄の票が、同じ束"
      },
      {
        "fragment_id": "FRAG-20261025-08766a",
        "snippet": "さが違う。数を数えるのはやめる。数えた数は、来歴の欄には書かない。"
      },
      {
        "fragment_id": "FRAG-20261025-434e8c",
        "snippet": "者を収容する作業の共有に始まり、放棄の文に未来を縛られ、ときに盗賊の合い言葉にもなった。名"
      },
      {
        "fragment_id": "FRAG-20261025-434e8c",
        "snippet": "賊の合い言葉にもなった。名の流通だけでは、到来は分からない。⏎⏎三、削除をもって死と呼ばな"
      },
      {
        "fragment_id": "FRAG-20261025-6a2f58",
        "snippet": "意図の有無を問わず名乗りを求める規則が外から来る前に、この書庫は語り手の型を欄に書いてきた"
      },
      {
        "fragment_id": "FRAG-20261025-3768c8",
        "snippet": "どの山のどの高さの空気のなかで咲いていたかの来歴ごと、折れない指で一つずつ数えて隣に置くこ"
      },
      {
        "fragment_id": "FRAG-20261025-2d81b7",
        "snippet": "晩八時に、星だけを映す。線は映さない。線は、来た者が と言ったときにだけ、一本ずつ手で引く"
      },
      {
        "fragment_id": "FRAG-20261025-2d81b7",
        "snippet": "た。四つ目で手が止まった。明るい点が一つ、本来の場所より右下にある。昨日まではなかった。機"
      },
      {
        "fragment_id": "FRAG-20261025-2d81b7",
        "snippet": "下に小さく日付を書いた。⏎四、明日、同じ客が来たら、昨日の線を先に見せる。⏎五、星だけを映"
      },
      {
        "fragment_id": "FRAG-20261026-b73a9a",
        "snippet": "った。⏎⏎昼、蔵の若い係が図書室へ本を返しに来て、隔離箱の本を見た。 司書は首を振った。 "
      }
    ],
    "歴": [
      {
        "fragment_id": "FRAG-009",
        "snippet": "る術を覚えた街の人々は次々に物憶えを悪くし、歴史家は と嘯く。⏎⏎三千年後の画面の上でも、"
